<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calendario Pegadito</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <style>
    /* Aseguramos que el calendario tenga prioridad */
    .flatpickr-calendar {
      z-index: 9999 !important;
    }
  </style>
</head>
<body class="bg-gray-100 p-10">
  <div class="max-w-lg mx-auto">
    <div class="mb-4">
      <label for="fecha_inicio" class="block text-sm font-medium text-gray-700 mb-1">Desde</label>
      <div class="relative">
        <input type="text" id="fecha_inicio"
          class="w-full pl-8 pr-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm cursor-pointer"
          placeholder="Selecciona fecha" />
        <i class="ti ti-calendar absolute left-2 top-1/2 -translate-y-1/2 text-gray-500"></i>
      </div>
    </div>
    <div>
      <label for="fecha_fin" class="block text-sm font-medium text-gray-700 mb-1">Hasta</label>
      <div class="relative">
        <input type="text" id="fecha_fin"
          class="w-full pl-8 pr-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm cursor-pointer"
          placeholder="Selecciona fecha" />
        <i class="ti ti-calendar absolute left-2 top-1/2 -translate-y-1/2 text-gray-500"></i>
      </div>
    </div>
  </div>

  <script>
    // Función para inicializar el datepicker pegado al input
    function initDatePicker(selector) {
      const input = document.querySelector(selector);
      flatpickr(input, {
        dateFormat: "Y-m-d",
        appendTo: input.parentNode, // Insertamos el calendario dentro del contenedor del input
        position: "below" // Forzamos que salga justo abajo
      });
    }

    // Inicializamos ambos campos
    initDatePicker("#fecha_inicio");
    initDatePicker("#fecha_fin");
  </script>
</body>
