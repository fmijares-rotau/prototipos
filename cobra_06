            ],
            '084434': [
                { name: 'Dawid Grzegorz Bzikowski', position: 'Asistente Financiero', status: 'Activo' }
            ],
            '084436': [
                { name: 'Jose Miguel Chumbas', position: 'Operario', status: 'Activo' },
                { name: 'Ana María López', position: 'Operario', status: 'Vacaciones' }
            ]
        };

        // Estado de la aplicación
        let state = {
            selectedEmployee: null,
            selectedDelegations: [],
            selectedQuotes: [],
            selectedRolesEmployees: [],
            relatedEmployees: []
        };

        // Inicialización
        document.addEventListener('DOMContentLoaded', function() {
            renderEmployeeOptions();
            renderLists();
            setupEventListeners();
            setupRolesTabs();
            setupModal();
        });

        // Configurar event listeners
        function setupEventListeners() {
            // Toggle del dropdown de empleados
            const toggleButton = document.getElementById('employee-select-toggle');
            const dropdown = document.getElementById('employee-select-dropdown');
            
            toggleButton.addEventListener('click', function() {
                const isOpen = dropdown.classList.contains('open');
                if (isOpen) {
                    dropdown.classList.remove('open');
                } else {
                    dropdown.classList.add('open');
                    document.getElementById('employee-search-input').focus();
                }
            });
            
            // Buscador dentro del dropdown
            const searchInput = document.getElementById('employee-search-input');
            searchInput.addEventListener('input', function() {
                filterEmployeeOptions(this.value.trim());
            });
            
            // Cerrar dropdown al hacer clic fuera
            document.addEventListener('click', function(event) {
                if (!event.target.closest('#employee-select-toggle') && !event.target.closest('#employee-select-dropdown')) {
                    dropdown.classList.remove('open');
                }
            });
            
            // Limpiar todo
            document.getElementById('limpiarFiltros').addEventListener('click', function() {
                searchInput.value = '';
                filterEmployeeOptions('');
                deselectEmployee();
                clearAllSelections();
            });
            
            // Botón Guardar Todo
            document.getElementById('guardar-todo').addEventListener('click', function() {
                showConfirmationModal();
            });
        }

        // Configurar modal
        function setupModal() {
            const modal = document.getElementById('confirmation-modal');
            const cancelBtn = document.getElementById('modal-cancel');
            const confirmBtn = document.getElementById('modal-confirm');

            cancelBtn.addEventListener('click', function() {
                modal.classList.add('hidden');
            });

            confirmBtn.addEventListener('click', function() {
                // Simular guardado exitoso
                modal.classList.add('hidden');
                alert('¡Todos los cambios han sido guardados exitosamente!');
                // Aquí iría la lógica real de guardado
            });

            // Cerrar modal al hacer clic fuera
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    modal.classList.add('hidden');
                }
            });
        }

        // Mostrar modal de confirmación
        function showConfirmationModal() {
            const modal = document.getElementById('confirmation-modal');
            
            // Actualizar información del modal
            document.getElementById('modal-employee').textContent = 
                state.selectedEmployee ? state.selectedEmployee.name : 'No seleccionado';
            document.getElementById('modal-delegations').textContent = state.selectedDelegations.length;
            document.getElementById('modal-quotes').textContent = state.selectedQuotes.length;
            document.getElementById('modal-roles-employees').textContent = state.selectedRolesEmployees.length;
            document.getElementById('modal-related').textContent = state.relatedEmployees.length;
            
            modal.classList.remove('hidden');
        }

        // Configurar pestañas de roles
        function setupRolesTabs() {
            const tabs = document.querySelectorAll('#tab-delegation, #tab-quotes, #tab-roles-employees');
            const contents = document.querySelectorAll('#content-delegation, #content-quotes, #content-roles-employees');
            
            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    // Desactivar todas las pestañas
                    tabs.forEach(t => {
                        t.classList.remove('active', 'border-blue-500', 'text-blue-600');
                        t.classList.add('border-transparent', 'text-gray-500');
                    });
                    
                    // Activar pestaña actual
                    this.classList.add('active', 'border-blue-500', 'text-blue-600');
                    this.classList.remove('border-transparent', 'text-gray-500');
                    
                    // Ocultar todos los contenidos
                    contents.forEach(content => {
                        content.classList.add('hidden');
                    });
                    
                    // Mostrar contenido correspondiente
                    const tabId = this.id.replace('tab-', 'content-');
                    document.getElementById(tabId).classList.remove('hidden');
                });
            });
        }

        // Renderizar listas
        function renderLists() {
            renderDelegationList();
            renderQuotesList();
            renderRolesEmployeesList();
        }

        function renderDelegationList() {
            const container = document.getElementById('delegation-list');
            container.innerHTML = '';
            
            delegations.forEach(delegation => {
                const isSelected = state.selectedDelegations.includes(delegation.id);
                const item = document.createElement('div');
                item.className = `checkbox-item p-4 flex items-center space-x-3 cursor-pointer ${isSelected ? 'selected' : ''}`;
                item.innerHTML = `
                    <input type="checkbox" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500" ${isSelected ? 'checked' : ''}>
                    <div>
                        <div class="font-medium text-gray-800">${delegation.name}</div>
                        <div class="text-sm text-gray-500">Responsable: ${delegation.responsible}</div>
                    </div>
                `;
                
                const checkbox = item.querySelector('input');
                item.addEventListener('click', function(e) {
                    if (e.target !== checkbox) {
                        checkbox.checked = !checkbox.checked;
                    }
                    updateSelection('delegation', delegation.id, checkbox.checked);
                });
                
                container.appendChild(item);
            });
        }

        function renderQuotesList() {
            const container = document.getElementById('quotes-list');
            container.innerHTML = '';
            
            quotes.forEach(quote => {
                const isSelected = state.selectedQuotes.includes(quote.id);
                const item = document.createElement('div');
                item.className = `checkbox-item p-4 flex items-center space-x-3 cursor-pointer ${isSelected ? 'selected' : ''}`;
                item.innerHTML = `
                    <input type="checkbox" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500" ${isSelected ? 'checked' : ''}>
                    <div class="flex-1">
                        <div class="font-medium text-gray-800">${quote.code} - ${quote.project}</div>
                        <div class="text-sm text-gray-500 flex justify-between mt-1">
                            <span>Cliente: ${quote.client}</span>
                            <span>Vencimiento: ${quote.dueDate}</span>
                        </div>
                    </div>
                `;
                
                const checkbox = item.querySelector('input');
                item.addEventListener('click', function(e) {
                    if (e.target !== checkbox) {
                        checkbox.checked = !checkbox.checked;
                    }
                    updateSelection('quote', quote.id, checkbox.checked);
                });
                
                container.appendChild(item);
            });
        }

        function renderRolesEmployeesList() {
            const container = document.getElementById('roles-employees-list');
            container.innerHTML = '';
            
            rolesEmployees.forEach(emp => {
                const isSelected = state.selectedRolesEmployees.includes(emp.id);
                const item = document.createElement('div');
                item.className = `checkbox-item p-4 flex items-center space-x-3 cursor-pointer ${isSelected ? 'selected' : ''}`;
                item.innerHTML = `
                    <input type="checkbox" class="h-4 w-4 text-blue-600 rounded focus:ring-blue-500" ${isSelected ? 'checked' : ''}>
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-xs font-bold">${emp.initials}</div>
                        <div>
                            <div class="font-medium text-gray-800">${emp.name}</div>
                            <div class="text-sm text-gray-500">${emp.department}</div>
                        </div>
                    </div>
                `;
                
                const checkbox = item.querySelector('input');
                item.addEventListener('click', function(e) {
                    if (e.target !== checkbox) {
                        checkbox.checked = !checkbox.checked;
                    }
                    updateSelection('rolesEmployee', emp.id, checkbox.checked);
                });
                
                container.appendChild(item);
            });
        }

        // Actualizar selecciones
        function updateSelection(type, id, isSelected) {
            let array, countElement;
            
            switch(type) {
                case 'delegation':
                    array = state.selectedDelegations;
                    countElement = document.getElementById('delegation-count');
                    break;
                case 'quote':
                    array = state.selectedQuotes;
                    countElement = document.getElementById('quotes-count');
                    break;
                case 'rolesEmployee':
                    array = state.selectedRolesEmployees;
                    countElement = document.getElementById('roles-employees-count');
                    break;
            }
            
            if (isSelected) {
                if (!array.includes(id)) {
                    array.push(id);
                }
            } else {
                const index = array.indexOf(id);
                if (index > -1) {
                    array.splice(index, 1);
                }
            }
            
            if (countElement) {
                countElement.textContent = array.length;
            }
            
            // Actualizar empleados relacionados
            updateRelatedEmployees();
        }

        // Actualizar empleados relacionados
        function updateRelatedEmployees() {
            const container = document.getElementById('related-employees-list');
            const countElement = document.getElementById('related-count');
            
            // Simular empleados relacionados basados en las selecciones
            state.relatedEmployees = [];
            
            // Empleados relacionados con delegaciones seleccionadas
            if (state.selectedDelegations.length > 0) {
                state.relatedEmployees.push(...rolesEmployees.slice(0, 2));
            }
            
            // Empleados relacionados con cotizaciones seleccionadas
            if (state.selectedQuotes.length > 0) {
                state.relatedEmployees.push(...rolesEmployees.slice(1, 3));
            }
            
            // Empleados seleccionados directamente
            if (state.selectedRolesEmployees.length > 0) {
                state.selectedRolesEmployees.forEach(id => {
                    const emp = rolesEmployees.find(e => e.id === id);
                    if (emp && !state.relatedEmployees.some(re => re.id === emp.id)) {
                        state.relatedEmployees.push(emp);
                    }
                });
            }
            
            // Eliminar duplicados
            state.relatedEmployees = state.relatedEmployees.filter((emp, index, self) =>
                index === self.findIndex(e => e.id === emp.id)
            );
            
            // Renderizar lista
            container.innerHTML = '';
            
            if (state.relatedEmployees.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-500">
                        <i class="ti ti-users text-4xl mb-3 text-gray-300"></i>
                        <p class="text-lg">No hay empleados relacionados</p>
                        <p class="text-sm mt-1">Seleccione elementos en el panel de roles</p>
                    </div>
                `;
            } else {
                state.relatedEmployees.forEach(emp => {
                    const item = document.createElement('div');
                    item.className = 'p-4 flex items-center space-x-3 border-b border-gray-200 last:border-b-0';
                    item.innerHTML = `
                        <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white text-sm font-bold">
                            ${emp.initials}
                        </div>
                        <div class="flex-1">
                            <div class="font-medium text-gray-800">${emp.name}</div>
                            <div class="text-sm text-gray-500">${emp.department}</div>
                        </div>
                    `;
                    container.appendChild(item);
                });
            }
            
            countElement.textContent = state.relatedEmployees.length;
        }

        // Limpiar todas las selecciones
        function clearAllSelections() {
            state.selectedDelegations = [];
            state.selectedQuotes = [];
            state.selectedRolesEmployees = [];
            state.relatedEmployees = [];
            
            // Actualizar contadores
            document.getElementById('delegation-count').textContent = '0';
            document.getElementById('quotes-count').textContent = '0';
            document.getElementById('roles-employees-count').textContent = '0';
            document.getElementById('related-count').textContent = '0';
            
            // Re-renderizar listas
            renderLists();
            updateRelatedEmployees();
        }

        // Renderizar opciones de empleados en el dropdown
        function renderEmployeeOptions() {
            const container = document.getElementById('employee-options-container');
            container.innerHTML = '';
            
            employees.forEach(employee => {
                const option = document.createElement('div');
                option.className = 'hs-select-option p-3 cursor-pointer rounded-md flex items-center gap-2 hover:bg-gray-100 mb-0.5';
                option.setAttribute('role', 'option');
                option.setAttribute('data-value', employee.id);
                option.innerHTML = `
                    <div class="employee-avatar w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-semibold">${employee.initials}</div>
                    <div class="employee-info flex-1">
                        <div class="employee-name font-medium text-sm">${employee.name}</div>
                        <div class="employee-details flex justify-between text-xs text-gray-500">
                            <span>ID: ${employee.id}</span>
                            <span>${employee.department}</span>
                        </div>
                    </div>
                `;
                option.addEventListener('click', function() {
                    selectEmployee(employee.id);
                    document.getElementById('employee-select-dropdown').classList.remove('open');
                });
                container.appendChild(option);
            });
        }

        // Filtrar opciones de empleados según la búsqueda
        function filterEmployeeOptions(query) {
            const container = document.getElementById('employee-options-container');
            const options = container.querySelectorAll('.hs-select-option');
            
            if (!query) {
                options.forEach(option => {
                    option.style.display = 'flex';
                });
                return;
            }
            
            const queryLower = query.toLowerCase();
            options.forEach(option => {
                const employeeId = option.getAttribute('data-value');
                const employee = employees.find(emp => emp.id === employeeId);
                
                if (employee && (
                    employee.name.toLowerCase().includes(queryLower) ||
                    employee.id.includes(query) ||
                    employee.company.toLowerCase().includes(queryLower) ||
                    employee.department.toLowerCase().includes(queryLower)
                )) {
                    option.style.display = 'flex';
                } else {
                    option.style.display = 'none';
                }
            });
        }

        // Seleccionar un empleado
        function selectEmployee(employeeId) {
            state.selectedEmployee = employees.find(emp => emp.id === employeeId);
            const employee = state.selectedEmployee;
            
            if (!employee) return;
            
            // Actualizar título del select
            document.getElementById('employee-select-title').textContent = employee.name;
            
            // Actualizar información en el panel principal
            const employeeInfo = document.getElementById('employee-info');
            document.getElementById('info-employee-name').textContent = employee.name;
            document.getElementById('info-employee-id').textContent = employee.id;
            document.getElementById('info-employee-company').textContent = employee.company;
            document.getElementById('info-employee-department').textContent = employee.department;
            document.getElementById('info-employee-subordinates').textContent = `${employee.subordinates} personas`;
            document.getElementById('employee-avatar').textContent = employee.initials;
            employeeInfo.classList.remove('hidden');
            
            // Actualizar personal a cargo
            renderSubordinates(employeeId);
            
            // Marcar como seleccionado en el dropdown
            const options = document.querySelectorAll('.hs-select-option');
            options.forEach(option => {
                if (option.getAttribute('data-value') === employeeId) {
                    option.classList.add('selected');
                } else {
                    option.classList.remove('selected');
                }
            });
        }

        // Deseleccionar empleado
        function deselectEmployee() {
            state.selectedEmployee = null;
            
            // Restablecer título del select
            document.getElementById('employee-select-title').textContent = 'Buscar empleado...';
            
            // Ocultar información en el panel principal
            document.getElementById('employee-info').classList.add('hidden');
            
            // Limpiar personal a cargo
            document.getElementById('subordinates-table-body').innerHTML = '';
            document.getElementById('no-subordinates').classList.remove('hidden');
            document.querySelector('#subordinates-container table').classList.add('hidden');
            
            // Quitar selección en el dropdown
            const options = document.querySelectorAll('.hs-select-option');
            options.forEach(option => {
                option.classList.remove('selected');
            });
        }

        // Renderizar personal a cargo
        function renderSubordinates(employeeId) {
            const subordinates = subordinatesData[employeeId] || [];
            const tbody = document.getElementById('subordinates-table-body');
            const noSubordinates = document.getElementById('no-subordinates');
            const table = document.querySelector('#subordinates-container table');
            
            tbody.innerHTML = '';
            
            if (subordinates.length > 0) {
                noSubordinates.classList.add('hidden');
                table.classList.remove('hidden');
                
                subordinates.forEach(sub => {
                    const statusColor = sub.status === 'Activo' ? 'text-green-600' : 'text-yellow-600';
                    const bgColor = sub.status === 'Activo' ? 'bg-green-100' : 'bg-yellow-100';
                    const row = document.createElement('tr');
                    row.className = 'hover:bg-gray-50 transition-colors';
                    row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">${sub.name}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${sub.position}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColor} ${bgColor}">
                                ${sub.status}
                            </span>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            } else {
                noSubordinates.classList.remove('hidden');
                table.classList.add('hidden');
            }
        }
    </script>
</body>
</html>